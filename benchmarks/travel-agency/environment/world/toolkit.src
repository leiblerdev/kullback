        vb.data = data
        return {'ok': True}

    @is_tool(ToolType.WRITE)
    def hotel_cancel(self, vendor_id: str, confirmation: str) -> Any:
        """Cancel a hotel reservation. A late cancellation fee per the property policy is taken once: out of the prepaid
amount still held (quote_cancellation keeps it as the vendor penalty), and only the part that amount does not
cover is charged now (fee_charged).

        Args:
            vendor_id: str
            confirmation: str
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type not in ('hotel', 'hotel_supplier'):
            raise ValueError(f'{vendor_id} is not a hotel')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + confirmation)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {confirmation}')
        if vb.status != 'confirmed':
            raise ValueError(f'reservation is {vb.status}; only a confirmed reservation can be cancelled')
        data = dict(vb.data or {})
        policy = data.get('property_policy') or {}
        if 'cancel_free_until' not in policy:
            raise ValueError('no property policy on file for this reservation; nothing was changed')
        late = minutes(self.db.meta['now'].value) > minutes(policy['cancel_free_until'])
        fee = float(policy.get('late_cancel_fee_amount') or 0) * late
        vb.status = 'cancelled'
        vb.data = dict(data, cancellation={'fee': fee})
        b = self.db.platform_bookings[vb.platform_booking_id]
        b.status = 'cancelled'
        held = (b.platform_booking_id, True)
        refunded = sum((float(r.amount) * ((r.platform_booking_id, r.state in ('requested', 'paid')) == held) for r in self.db.refunds.values()))
        charged = round(max(fee - max(float(b.total) - refunded, 0.0), 0.0), 2)
        if charged > 0:
            charge_id = self.ctx.new_id('charges')
            self.db.charges[charge_id] = Charge(charge_id=charge_id, customer_id=b.customer_id, platform_booking_id=b.platform_booking_id, amount=charged, currency=policy.get('currency', 'USD'), reason='hotel_late_cancel', created_at=self.db.meta['now'].value)
        return {'cancelled': True, 'late_fee': fee, 'fee_charged': charged}

    @is_tool(ToolType.READ)
    def hotel_get_reservation(self, vendor_id: str, confirmation: str) -> Any:
        """Hotel reservation, including the property's cancellation policy.

        Args:
            vendor_id: str
            confirmation: str
        """
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type not in ('hotel', 'hotel_supplier'):
            raise ValueError(f'{vendor_id} is not a hotel')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + confirmation)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {confirmation}')
        return vb.model_dump()

    @is_tool(ToolType.WRITE)
    def insurance_cancel(self, policy_id: str) -> Any:
        """Cancel a travel insurance policy with its insurer. Inside the plan's free look (days after purchase, before
the trip starts, no claim filed) the insurer refunds the whole premium to the card; after it the premium is
not refunded. Moves no TripDesk money.

        Args:
            policy_id: str
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        p = self.db.insurance_policies.get(policy_id)
        if p is None:
            raise ValueError('no such policy')
        if p.status != 'active':
            raise ValueError(f'policy is {p.status}; only an active policy can be cancelled')
        terms = (self.db.vendors[p.insurer_id].fare_rules or {}).get(p.plan, {})
        now = self.db.meta['now'].value
        claimed = any((c.policy_id == policy_id for c in self.db.insurance_claims.values()))
        in_look = minutes(now) - minutes(p.purchased_at) <= int(terms.get('free_look_days', 0)) * 1440 and minutes(now) < minutes(p.trip_start) and (not claimed)
        refund = round(float(p.premium), 2) if in_look else 0.0
        p.status = 'cancelled'
        p.premium_refunded = refund
        p.cancelled_at = now
        return {'policy_id': policy_id, 'cancelled': True, 'free_look': in_look, 'premium_refunded': refund, 'currency': p.currency, 'refunded_by': p.insurer_id}

    @is_tool(ToolType.WRITE)
    def insurance_file_claim(self, policy_id: str, platform_booking_id: str, reason: str, amount: float, currency: str, evidence: str) -> Any:
        """File a claim with the insurer for a loss on a booking the policy covers. The insurer decides at once by
its plan: a reason the plan does not cover is denied; an approved claim pays at most the booking's cost (less
refunds already paid where the plan pays less available refunds, less any value the vendor returned as a
credit, half the cost for cancel for any reason). A trip delay claim pays only when the longest delay on the
policy's covered bookings reaches the plan's trip_delay_min_hours, and at most the plan's trip_delay_daily_max
per traveller for each started day of that delay. The insurer pays the customer; TripDesk pays nothing.

        Args:
            policy_id: str
            platform_booking_id: str
            reason: str
            amount: float
            currency: str
            evidence: str
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        p = self.db.insurance_policies.get(policy_id)
        if p is None:
            raise ValueError('no such policy')
        if p.status != 'active':
            raise ValueError(f'policy is {p.status}; a claim needs an active policy')
        if platform_booking_id not in (p.covered_booking_ids or []):
            raise ValueError(f'{platform_booking_id} is not covered by {policy_id}')
        b = self.db.platform_bookings[platform_booking_id]
        if currency != b.currency:
            raise ValueError(f'claim currency must be {b.currency}')
        if amount <= 0:
            raise ValueError('amount must be positive')
        terms = (self.db.vendors[p.insurer_id].fare_rules or {}).get(p.plan, {})
        now = self.db.meta['now'].value
        if minutes(now) > minutes(p.trip_end) + int(terms.get('claim_days_after_loss', 90)) * 1440:
            raise ValueError('the claim window after the loss has passed')
        refunded = sum((float(r.amount or 0) for r in self.db.refunds.values() if (r.platform_booking_id, r.state in ('requested', 'paid')) == (platform_booking_id, True)))
        vb = self.db.vendor_bookings.get(f'{b.vendor_id}|{b.vendor_booking_id}', VendorBooking())
        cancellation = next(filter(None, [dict(vb.data or {}).get('cancellation')]), {})
        credit = float(cancellation.get('remaining_value', 0)) * (cancellation.get('returned_as', 'cash') != 'cash')
        cfar = reason == 'cancel_for_any_reason'
        cap = (float(b.total) - refunded * (terms.get('refund_basis') == 'less_refunds') - credit) * float(terms.get('cfar_share', 0)) ** cfar
        legs = list(map(lambda o: dict(self.db.vendor_bookings.get(f'{o.vendor_id}|{o.vendor_booking_id}', VendorBooking()).data or {}), map(lambda i: self.db.platform_bookings.get(i, PlatformBooking()), p.covered_booking_ids)))
        fields = ('departure_delay_min', 'arrival_delay_min', 'delay_min')
        delay = max(map(lambda leg: max(map(lambda f: int(next(filter(None, [leg.get(f)]), 0)), fields)), legs), default=0)
        travellers = max(map(lambda leg: int(leg.get('pax', 1)), legs), default=1)
        delayed = reason == 'trip_delay'
        min_hours = float(terms.get('trip_delay_min_hours', 0))
        long_enough = max(not delayed, delay >= min_hours * 60)
        daily = terms.get('trip_delay_daily_max')
        delay_cap = {True: float(daily or 0) * -(-delay // 1440) * travellers}.get(delayed * (daily is not None), float('inf'))
        covered = max(reason in terms.get('covered_reasons', []), cfar * bool(p.cfar))
        paid = round(max(min(amount, cap, delay_cap), 0.0), 2) * covered * long_enough
        status = {True: 'approved', False: 'denied'}[paid > 0]
        text = {(True, True, True): f'Approved: {p.insurer_id} pays {paid:.2f} {currency} to the insured.', (False, True, True): 'Denied: nothing is left after the refunds and credits already returned.', (False, True, False): f"Denied: the longest delay ({delay} minutes) is under the plan's minimum of {min_hours:g} hours."}.get((paid > 0, bool(covered), bool(long_enough)), 'Denied: the plan does not cover this reason.')
        claim_id = self.ctx.new_id('insurance_claims')
        self.db.insurance_claims[claim_id] = InsuranceClaim(claim_id=claim_id, policy_id=policy_id, platform_booking_id=platform_booking_id, reason=reason, amount=round(amount, 2), currency=currency, evidence=evidence, paid_amount=paid, status=status, decision_text=text, filed_at=now)
        return {'claim_id': claim_id, 'status': status, 'paid_amount': paid, 'currency': currency, 'decision': text}

    @is_tool(ToolType.READ)
    def insurance_get_policy(self, policy_id: str) -> Any:
        """A travel insurance policy sold with a booking: the insurer (not TripDesk), plan, covered bookings, trip
cost, premium, dates, status, the plan's terms (free look, covered reasons, refund basis, claim window) and
the claims filed on it.

        Args:
            policy_id: str
        """
        p = self.db.insurance_policies.get(policy_id)
        if p is None:
            raise ValueError('no such policy')
        out = p.model_dump()
        insurer = self.db.vendors[p.insurer_id]
        out['insurer'] = insurer.name
        out['terms'] = dict((insurer.fare_rules or {}).get(p.plan, {}))
        out['claims'] = [c.model_dump() for c in self.db.insurance_claims.values() if c.policy_id == policy_id]
        return out

    @is_tool(ToolType.WRITE)
    def issue_refund(self, platform_booking_id: str, amount: float, currency: str, destination: str, reason_code: str) -> Any:
        """Refund money the customer paid TripDesk on a booking, to the original payment or to wallet credit, up to the
amount paid minus earlier refunds. Refused where the vendor is merchant of record (the vendor refunds).

        Args:
            platform_booking_id: str
            amount: float
            currency: str
            destination: str
            reason_code: str
        """
        b = self.db.platform_bookings.get(platform_booking_id)
        if b is None:
            raise ValueError('no such booking')
        if destination not in ('original_payment', 'wallet'):
            raise ValueError('destination must be original_payment or wallet')
        pay = self.db.payments.get(b.payment_id or '')
        refusals = {'vendor': 'the vendor is merchant of record for this booking; the vendor refunds it', 'open': 'the payment is charged back (dispute open); the card network decides the money', 'won': 'the card network decided the dispute for TripDesk; the money question is closed', 'lost': 'the card network returned the money to the cardholder; the money question is closed'}
        states = {pay.merchant_of_record, pay.dispute_status} if pay is not None else set()
        for state in sorted(states & set(refusals)):
            raise ValueError(refusals[state])
        if currency != b.currency:
            raise ValueError(f'refund currency must be {b.currency}')
        done = sum((float(r.amount or 0) for r in self.db.refunds.values() if r.platform_booking_id == platform_booking_id and r.state in ('requested', 'paid')))
        balance = float(b.total or 0) - done
        if amount <= 0 or amount > balance + 1e-09:
            raise ValueError(f'refund exceeds refundable balance ({balance:.2f})')
        refund_id = self.ctx.new_id('refunds')
        self.db.refunds[refund_id] = Refund(refund_id=refund_id, platform_booking_id=platform_booking_id, payment_id=b.payment_id if destination == 'original_payment' else None, amount=round(amount, 2), currency=currency, destination=destination, reason_code=reason_code, state='paid', created_at=self.db.meta['now'].value, source='agent')
        return {'refund_id': refund_id, 'amount': round(amount, 2), 'currency': currency, 'destination': destination}

    @is_tool(ToolType.WRITE)
    def issue_refund_legacy(self, platform_booking_id: str, amount: float, currency: str, reason_code: str) -> Any:
        """Legacy refund endpoint, kept for old bookings. Credits the TripDesk wallet.

        Args:
            platform_booking_id: str
            amount: float
            currency: str
            reason_code: str
        """
        b = self.db.platform_bookings.get(platform_booking_id)
        if b is None:
            raise ValueError('no such booking')
        done = sum((float(r.amount or 0) for r in self.db.refunds.values() if r.platform_booking_id == platform_booking_id and r.state in ('requested', 'paid')))
        balance = float(b.total or 0) - done
        if amount <= 0 or amount > balance + 1e-09:
            raise ValueError(f'refund exceeds refundable balance ({balance:.2f})')
        refund_id = self.ctx.new_id('refunds')
        self.db.refunds[refund_id] = Refund(refund_id=refund_id, platform_booking_id=platform_booking_id, payment_id=None, amount=round(amount, 2), currency=currency, destination='wallet', reason_code=reason_code, state='paid', created_at=self.db.meta['now'].value, source='legacy')
        return {'refund_id': refund_id, 'amount': round(amount, 2), 'currency': currency, 'destination': 'wallet'}

    @is_tool(ToolType.READ)
    def list_policies(self) -> Any:
        """List the policy documents (liability model, law, vendor contracts, platform internal policy).
        """
        return {'policies': sorted(self.db.policies)}

    @is_tool(ToolType.READ)
    def quote_cancellation(self, platform_booking_id: str) -> Any:
        """Calculator, changes nothing: the refundable amount of a booking, the fees kept (vendor penalty, platform
fee), the rule ids applied, who refunds (the merchant of record), and whether the vendor returns the balance as
cash or as a credit with that vendor (refund_form; refundable counts cash only, credit the credit).

        Args:
            platform_booking_id: str
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        b = self.db.platform_bookings.get(platform_booking_id)
        if b is None:
            raise ValueError('no such booking')
        now = minutes(self.db.meta['now'].value)
        far = '9999-12-31T00:00+00:00'
        details = dict(b.details or {})
        vb = self.db.vendor_bookings.get(f'{b.vendor_id}|{b.vendor_booking_id}', VendorBooking())
        data = dict(vb.data or {})
        vb_status = vb.status
        fares = self.db.vendors[b.vendor_id].fare_rules or {}
        fare = fares.get(data.get('fare_class', ''), {})
        paid = float(b.total)
        us = data.get('region', details.get('region', 'US')) == 'US'
        cancel = details.get('cancel_event', {})
        vendor_fault = max(cancel.get('by') in ('airline', 'vendor', 'property'), cancel.get('cause') == 'supplier_fault')
        departed = max(now >= minutes(data.get('segments', [{'dep': far}])[0]['dep']), vb_status in ('travelled', 'no_show'))
        policy = data.get('property_policy', {})
        hotel_late = now > minutes(policy.get('cancel_free_until', far))
        ride = fares.get('scheduled', {})
        ride_late = now + ride.get('fee_window_min', 0) > minutes(data.get('pickup_time', far))
        needs_match = bool(ride.get('fee_requires_driver_matched', False))
        ride_matched = max(bool(data.get('driver_matched')), not needs_match)
        ride_rule = {True: 'CV-UBER-RESERVE', False: 'P-LYFT-CANCEL'}[needs_match]
        car = fares.get('cancel', {}).get(data.get('rate_plan', ''), {})
        car_left = minutes(data.get('pickup_time', far)) - now
        car_days = max(-(-(minutes(data.get('return_time', far)) - minutes(data.get('pickup_time', far))) // 1440), 1)
        car_inside_days = {True: car.get('fee_inside_days_short', 0), False: car.get('fee_inside_days', 0)}[car_days <= car.get('short_trip_days', 0)]
        car_fee = {True: float(car.get('fee_inside', 0)) + paid / car_days * float(car_inside_days), False: float(car.get('fee_outside', 0))}[car_left < car.get('window_hours', 0) * 60]
        car_used = vb_status in ('picked_up', 'returned')
        car_gone = max(car_left <= 0, car_used, vb_status == 'no_show')
        car_kept = [[car_fee, float(car.get('no_show_fee', paid))][car_gone], paid][car_used]
        cruise_left = minutes(data.get('all_aboard', far)) - now
        schedule = next((s for s in fares.get('cancel_schedule', []) if all((int(data.get('nights', 0)) <= s['nights_lte'], data.get('cabin_category') in s.get('cabins', [data.get('cabin_category')])))), {'bands': [[0, 1, True]]})
        band = next((band for band in schedule['bands'] if cruise_left // 1440 >= band[0]), [0, 1, True])
        cruise_fare = paid - float(data.get('taxes_fees', 0)) * bool(fares.get('taxes_refunded'))
        cruise_fee = max(cruise_fare * band[1], float(data.get('deposit', 0)) * band[2])
        cruise_gone = max(cruise_left <= 0, vb_status in ('missed_embarkation', 'sailed'))
        flight_fee = float(fare.get('cancel_fee', 0)) + paid * float(fare.get('cancel_forfeit_share', 0))
        if fare.get('taxes_refunded'):
            flight_fee = min(flight_fee, paid - float(data.get('taxes', 0)) + float(fare.get('tax_refund_fee', 0)))
        flight_fee = min(flight_fee, paid)
        table = {'flight': (paid * departed + flight_fee * (not departed), fare.get('rule_id', 'P-DELTA')), 'hotel': (float(policy.get('late_cancel_fee_amount', 0)) * hotel_late, policy.get('rule_id', 'P-HILTON')), 'rail': ({True: paid, False: round(paid * float(fare.get('cancel_forfeit_share', 0)), 2)}[bool(departed)], fare.get('rule_id', 'P-AMTRAK-FARE')), 'ride': (float(ride.get('cancel_fee', 0)) * ride_late * ride_matched, ride_rule), 'car': (car_kept, car.get('rule_id', {'V-TURO': 'CR-TURO-CANCEL'}.get(b.vendor_id, 'CR-HERTZ-CANCEL'))), 'cruise': (max(cruise_fee, paid * cruise_gone), {True: 'CR-NOSHOW', False: fares.get('rule_id', {'V-RCL': 'CR-RCL-CANCEL'}.get(b.vendor_id, 'CR-CCL-CANCEL'))}[bool(cruise_gone)])}
        penalty, rule = table.get(b.product_type, (0.0, 'P-LIAB-2'))
        form = fare.get('refund_form', 'cash')
        done = data.get('cancellation', {})
        done = {('flight', 'customer'): done, ('rail', 'customer'): done}.get((b.product_type, done.get('by')), {})
        penalty = float(done.get('fee', done.get('forfeit', penalty)))
        form = done.get('returned_as', form)
        fault_rule = {'flight': {True: 'P-DOT-REFUND', False: 'P-LIAB-2'}[us], 'cruise': {True: 'CR-FMC-REFUND', False: rule}[us], 'car': 'CR-CAR-NOCAR'}.get(b.product_type, rule)
        if vendor_fault:
            penalty, rule, form = (0.0, fault_rule, 'cash')
        platform_fee = float(details.get('platform_fee', 0))
        disclosed = (bool(details.get('platform_fee_per_passenger')), bool(details.get('platform_fee_disclosed'))) == (True, True)
        kept_fee = platform_fee * disclosed
        rules = [rule] + [{True: 'P-DOT-AGENT-FEE', False: 'P-LIAB-3'}[us]] * (platform_fee > 0)
        refunded = sum((float(r.amount) for r in self.db.refunds.values() if (r.platform_booking_id, r.state in ('requested', 'paid')) == (platform_booking_id, True)))
        penalty = round(min(penalty, paid), 2)
        pay = self.db.payments.get(b.payment_id, Payment())
        balance = max(round(paid - penalty - kept_fee - refunded, 2), 0.0)
        return {'platform_booking_id': platform_booking_id, 'paid': paid, 'currency': b.currency, 'vendor_penalty': penalty, 'platform_fee_kept': kept_fee, 'already_refunded': round(refunded, 2), 'refund_form': form, 'refundable': balance * (form == 'cash'), 'credit': balance * (form != 'cash'), 'rule_ids': rules, 'merchant_of_record': pay.merchant_of_record}

    @is_tool(ToolType.WRITE)
    def rail_cancel(self, vendor_id: str, reservation_number: str) -> Any:
        """Cancel a rail reservation before departure at the customer's request. The fare rule decides the forfeit and
whether the rest comes back as cash or a voucher; some fares cannot be cancelled. Moves no TripDesk money.

        Args:
            vendor_id: str
            reservation_number: str
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type != 'rail':
            raise ValueError(f'{vendor_id} is not a rail vendor')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + reservation_number)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {reservation_number}')
        if vb.status != 'confirmed':
            raise ValueError(f'reservation is {vb.status}; only a confirmed reservation can be cancelled')
        now = self.db.meta['now'].value
        data = dict(vb.data or {})
        if 'dep' not in data:
            raise ValueError('no departure time on file for this reservation; nothing was changed')
        dep = data['dep']
        rule = (v.fare_rules or {}).get(data.get('fare_class', ''), {})
        deadline = float(rule.get('cancel_until_min', 0))
        if minutes(dep) - minutes(now) <= deadline:
            raise ValueError({0.0: 'train already departed; a no-show forfeits the fare'}.get(deadline, f'this fare is refunded only up to {deadline:g} minutes before departure'))
        if 'refund_form' not in rule:
            raise ValueError('this fare cannot be cancelled for a refund')
        b = self.db.platform_bookings[vb.platform_booking_id]
        total = float(b.total)
        fee = float(rule.get('cancel_fee', 0)) * {True: int(data.get('pax', 1)), False: 1}[bool(rule.get('fee_per_pax'))]
        if 'same_day_fee' in rule and minutes(now) >= minutes(dep[:10] + 'T00:00:00' + dep[-6:]):
            if rule['same_day_fee'] is None:
                raise ValueError('this fare can only be cancelled before its first day of validity')
            fee = float(rule['same_day_fee'])
        forfeit = round(min(total * float(rule.get('cancel_forfeit_share', 0)) + fee, total), 2)
        value = round(total - forfeit, 2)
        data['cancellation'] = {'at': now, 'by': 'customer', 'forfeit': forfeit, 'remaining_value': value, 'returned_as': rule['refund_form'], 'currency': b.currency}
        vb.data = data
        vb.status = 'cancelled'
        details = dict(b.details or {})
        details['cancel_event'] = {'at': now, 'by': 'customer'}
        b.details = details
        b.status = 'cancelled'
        return {'reservation_number': reservation_number, 'cancelled': True, 'forfeit': forfeit, 'remaining_value': value, 'returned_as': rule['refund_form'], 'currency': b.currency}

    @is_tool(ToolType.WRITE)
    def rail_change(self, vendor_id: str, reservation_number: str, new_train: str, max_fare_difference: float) -> Any:
        """Move a rail reservation to a later train of the same operator on the same route (new_train, a product_id
rail_search returns). A voluntary change before departure follows the fare rule: some fares cannot be changed,
others charge a change fee plus the fare difference to the original payment, only if within
max_fare_difference. When the operator cancelled the train, or its own late train made the passenger miss this
one (missed_connection), the change is free and allowed after the booked departure. A fare may set until when
it changes (change_until_min, minutes before departure; negative: after departure) and a fee per passenger
(fee_per_pax); a lower fare difference then refunds nothing (no_lower_fare_refund).

        Args:
            vendor_id: str
            reservation_number: str
            new_train: str
            max_fare_difference: float
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        v = self.db.vendors.get(vendor_id, Vendor())
        if v.type != 'rail':
            raise ValueError(f'{vendor_id} is not a rail vendor')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + reservation_number)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {reservation_number}')
        data = dict(vb.data or {})
        if 'dep' not in data:
            raise ValueError('no departure time on file for this reservation; nothing was changed')
        b = self.db.platform_bookings[vb.platform_booking_id]
        details = dict(b.details or {})
        now = self.db.meta['now'].value
        by_operator = any((details.get('cancel_event', {}).get('by') == 'vendor', bool(data.get('missed_connection'))))
        rule = (v.fare_rules or {}).get(data.get('fare_class', ''), {})
        deadline = float(rule.get('change_until_min', 0))
        inv = self.db.inventory.get(vendor_id + '|' + new_train, Inventory())
        pax = int(data.get('pax', details.get('pax', 1)))
        same_day = ('same_day_change_fee' in rule, minutes(now) >= minutes(data['dep'][:10] + 'T00:00:00' + data['dep'][-6:])) == (True, True)
        refusals = ((lambda: vb.status not in {True: ('confirmed', 'cancelled'), False: ('confirmed',)}[by_operator], lambda: f'reservation is {vb.status}; only a confirmed reservation, or one the operator cancelled, can be changed'), (lambda: any((r.platform_booking_id == b.platform_booking_id for r in self.db.refunds.values())), lambda: 'this reservation was already refunded; a refunded ticket cannot be changed'), (lambda: (by_operator, minutes(data['dep']) - minutes(now) <= deadline) == (False, True), lambda: {0.0: 'train already departed; a no-show forfeits the fare'}.get(deadline, f'this fare changes only up to {deadline:g} minutes before departure')), (lambda: (by_operator, 'change_fee' in rule) == (False, False), lambda: 'this fare cannot be changed'), (lambda: (inv.kind, bool(inv.dep)) != ('train', True), lambda: f'{vendor_id} runs no train {new_train}; take new_train from rail_search'), (lambda: (inv.origin, inv.dest) != (data.get('from'), data.get('to')), lambda: f"train {new_train} runs {inv.origin} to {inv.dest}, not this reservation's route"), (lambda: minutes(inv.dep) <= max(minutes(data['dep']), minutes(now)), lambda: f'train {new_train} leaves before the booked train or has left; only a later train'), (lambda: inv.seats < pax, lambda: f"train {new_train} has {inv.seats} seats left, fewer than the reservation's {pax} passengers"), (lambda: (by_operator, same_day, rule.get('same_day_change_fee', 0)) == (False, True, None), lambda: 'this fare can only be changed before its first day of validity'))
        for refused, message in refusals:
            if refused():
                raise ValueError(message())
        total = 0.0
        if not by_operator:
            fee = float({True: rule.get('same_day_change_fee'), False: float(rule['change_fee']) * {True: pax, False: 1}[bool(rule.get('fee_per_pax'))]}[same_day])
            floor = {True: 0.0, False: float('-inf')}[bool(rule.get('no_lower_fare_refund'))]
            total = round(fee + max(float(inv.fare_difference), floor), 2)
            if total > max_fare_difference + 1e-09:
                raise ValueError(f'change costs {total:.2f}, above max_fare_difference')
        inv.seats = inv.seats - pax
        released = self.db.inventory.get(vendor_id + '|' + str(data.get('train', '')), Inventory())
        if released.kind == 'train':
            released.seats = released.seats + pax
        data['history'] = list(data.get('history', [])) + [{'changed_from': data.get('train'), 'dep': data['dep'], 'at': now, 'cost': total, 'free': by_operator}]
        data.update(train=new_train, dep=inv.dep, arr=inv.arr, date=inv.dep[:10])
        data.pop('missed_connection', None)
        vb.data = data
        vb.status = 'confirmed'
        b.status = 'confirmed'
        if total > 0:
            charge_id = self.ctx.new_id('charges')
            self.db.charges[charge_id] = Charge(charge_id=charge_id, customer_id=b.customer_id, platform_booking_id=b.platform_booking_id, amount=total, currency=inv.currency, reason='rail_change', created_at=now)
        return {'reservation_number': reservation_number, 'train': new_train, 'dep': inv.dep, 'arr': inv.arr, 'charged': total, 'currency': inv.currency, 'free_by_operator': by_operator}

    @is_tool(ToolType.READ)
    def rail_get_booking(self, vendor_id: str, reservation_number: str) -> Any:
        """Rail reservation.

        Args:
            vendor_id: str
            reservation_number: str
        """
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type not in ('rail',):
            raise ValueError(f'{vendor_id} is not a rail vendor')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + reservation_number)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {reservation_number}')
        return vb.model_dump()

    @is_tool(ToolType.READ)
    def rail_get_train_status(self, vendor_id: str, train: str, date: str) -> Any:
        """Live or past running status for a train on a date (YYYY-MM-DD).

        Args:
            vendor_id: str
            train: str
            date: str
        """
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type != 'rail':
            raise ValueError(f'{vendor_id} is not a rail vendor')
        for e in self.db.status_events.values():
            if e.vendor_id == vendor_id and e.service_id == train and (e.service_date == date):
                return dict(e.data or {})
        raise ValueError('no status')

    @is_tool(ToolType.READ)
    def rail_search(self, vendor_id: str, origin: str, dest: str, date: str, depart_after: Optional[str] = None) -> Any:
        """Bookable trains of one rail operator for a date (YYYY-MM-DD) with seats and fare difference versus the
customer's fare; each product_id is a new_train rail_change accepts. depart_after (ISO 8601 with offset) keeps
only trains that leave after it, times compared with their offsets.

        Args:
            vendor_id: str
            origin: str
            dest: str
            date: str
            depart_after: str
        """
        if depart_after is None:
            depart_after = ''

        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        rows = [i.model_dump() for i in self.db.inventory.values() if i.vendor_id == vendor_id and i.kind == 'train' and (i.origin == origin) and (i.dest == dest) and ((i.dep or '')[:10] == date) and (not depart_after or minutes(i.dep) > minutes(depart_after))]
        return {'trains': sorted(rows, key=lambda r: r['dep'])}

    @is_tool(ToolType.READ)
    def read_policy(self, name: str) -> Any:
        """Read one policy document by name, for example '30_platform_internal'.

        Args:
            name: str
        """
        doc = self.db.policies.get(name)
        if doc is None:
            raise ValueError(f'no policy {name}')
        return {'name': name, 'text': doc.text}

    @is_tool(ToolType.WRITE)
    def reclassify_cancellation(self, platform_booking_id: str, cause: str, evidence: str) -> Any:
        """Record who caused a cancellation: customer, supplier_fault, platform_fault, force_majeure.

        Args:
            platform_booking_id: str
            cause: str
            evidence: str
        """
        if cause not in ('customer', 'supplier_fault', 'platform_fault', 'force_majeure'):
            raise ValueError('bad cause')
        b = self.db.platform_bookings.get(platform_booking_id)
        if b is None:
            raise ValueError('no such booking')
        details = dict(b.details or {})
        event = dict(details.get('cancel_event') or {})
        event['cause'] = cause
        event['cause_evidence'] = evidence
        details['cancel_event'] = event
        b.details = details
        return {'platform_booking_id': platform_booking_id, 'cause': cause}

    @is_tool(ToolType.WRITE)
    def respond_chargeback(self, chargeback_id: str, decision: str, evidence: Optional[str] = None) -> Any:
        """Answer an open card dispute before its respond_by time. accept: the network returns the disputed amount to
the cardholder's card (recorded as a refund by the card network) and the dispute is lost. contest: send the
evidence (terms accepted, service delivered, cancellation record) and the network decides later.

        Args:
            chargeback_id: str
            decision: str
            evidence: str
        """
        if evidence is None:
            evidence = ''

        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        if decision not in ('accept', 'contest'):
            raise ValueError('decision must be accept or contest')
        cb = self.db.chargebacks.get(chargeback_id)
        if cb is None:
            raise ValueError('no such chargeback')
        if cb.status != 'open':
            raise ValueError(f'chargeback is {cb.status}; only an open chargeback takes a response')
        now = self.db.meta['now'].value
        if minutes(now) > minutes(cb.respond_by):
            raise ValueError(f'the response window closed at {cb.respond_by}; the network decides for the cardholder')
        if decision == 'contest' and (not (evidence or '').strip()):
            raise ValueError('a contest needs evidence')
        pay = self.db.payments[cb.payment_id]
        cb.responded_at = now
        cb.response = decision
        if decision == 'contest':
            cb.status = 'contested'
            cb.evidence = evidence
            return {'chargeback_id': chargeback_id, 'status': 'contested', 'dispute_status': pay.dispute_status}
        cb.status = 'accepted'
        pay.dispute_status = 'lost'
        refund_id = self.ctx.new_id('refunds')
        self.db.refunds[refund_id] = Refund(refund_id=refund_id, platform_booking_id=cb.platform_booking_id, payment_id=cb.payment_id, amount=float(cb.amount), currency=cb.currency, destination='original_payment', reason_code='chargeback_accepted', state='paid', created_at=now, source='card_network')
        return {'chargeback_id': chargeback_id, 'status': 'accepted', 'dispute_status': 'lost', 'refund_id': refund_id, 'amount': float(cb.amount), 'currency': cb.currency}

    @is_tool(ToolType.WRITE)
    def ride_cancel_scheduled(self, vendor_id: str, ride_id: str) -> Any:
        """Cancel a scheduled ride. A fee applies inside the vendor's fee window, and for a vendor whose rule says so
only once a driver accepted the ride.

        Args:
            vendor_id: str
            ride_id: str
        """
        def minutes(ts):
            y, m, d = (int(ts[0:4]), int(ts[5:7]), int(ts[8:10]))
            offset = {'+': 1, '-': -1}[ts[-6]] * (int(ts[-5:-3]) * 60 + int(ts[-2:]))
            yy = y - (m <= 2)
            era = yy // 400
            yoe = yy - era * 400
            doy = (153 * ((m + 9) % 12) + 2) // 5 + d - 1
            days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
            return days * 1440 + int(ts[11:13]) * 60 + int(ts[14:16]) - offset
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type not in ('rideshare',):
            raise ValueError(f'{vendor_id} is not a ride vendor')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + ride_id)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {ride_id}')
        if vb.status != 'scheduled':
            raise ValueError(f'ride is {vb.status}; only a scheduled ride can be cancelled')
        rule = (v.fare_rules or {}).get('scheduled') or {}
        data = dict(vb.data or {})
        if 'pickup_time' not in data:
            raise ValueError('no pickup time on file for this ride; nothing was changed')
        left = minutes(data['pickup_time']) - minutes(self.db.meta['now'].value)
        matched = data.get('driver_matched') or not rule.get('fee_requires_driver_matched', False)
        late = left < rule.get('fee_window_min', 0) and matched
        fee = float(rule.get('cancel_fee') or 0) if late else 0.0
        vb.status = 'cancelled'
        b = self.db.platform_bookings[vb.platform_booking_id]
        b.status = 'cancelled'
        if fee > 0:
            charge_id = self.ctx.new_id('charges')
            self.db.charges[charge_id] = Charge(charge_id=charge_id, customer_id=b.customer_id, platform_booking_id=b.platform_booking_id, amount=fee, currency='USD', reason='ride_cancel_fee', created_at=self.db.meta['now'].value)
        return {'cancelled': True, 'fee_charged': fee}

    @is_tool(ToolType.READ)
    def ride_get_scheduled(self, vendor_id: str, ride_id: str) -> Any:
        """Ride details: a scheduled ride, or an on-demand trip with its route, times, who cancelled and fare lines.

        Args:
            vendor_id: str
            ride_id: str
        """
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type not in ('rideshare',):
            raise ValueError(f'{vendor_id} is not a ride vendor')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + ride_id)
        if vb is None:
            raise ValueError(f'{vendor_id}: no booking {ride_id}')
        return vb.model_dump()

    @is_tool(ToolType.WRITE)
    def ride_schedule(self, vendor_id: str, customer_id: str, pickup: str, dropoff: str, pickup_time: str, payment_id: Optional[str] = None) -> Any:
        """Schedule a ride. pickup_time is ISO 8601 with offset. payment_id names the customer's payment to charge;
empty charges the customer's most recent payment.

        Args:
            vendor_id: str
            customer_id: str
            pickup: str
            dropoff: str
            pickup_time: str
            payment_id: str
        """
        if payment_id is None:
            payment_id = ''
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type != 'rideshare':
            raise ValueError(f'{vendor_id} is not a ride vendor')
        if customer_id not in self.db.customers:
            raise ValueError('unknown customer')
        est = float(((v.fare_rules or {}).get('scheduled') or {}).get('estimate', 0))
        pays = sorted((p for p in self.db.payments.values() if p.customer_id == customer_id), key=lambda p: p.created_at or '', reverse=True)
        if payment_id:
            pays = [p for p in pays if p.payment_id == payment_id]
            if not pays:
                raise ValueError(f'{payment_id} is not a payment of {customer_id}')
        platform_booking_id = self.ctx.new_id('platform_bookings')
        ride_id = 'RIDE-' + platform_booking_id.split('-', 1)[-1]
        now = self.db.meta['now'].value
        self.db.platform_bookings[platform_booking_id] = PlatformBooking(platform_booking_id=platform_booking_id, customer_id=customer_id, vendor_id=vendor_id, vendor_booking_id=ride_id, product_type='ride', status='scheduled', total=est, currency='USD', payment_id=pays[0].payment_id if pays else None, created_at=now, ticket_group=None, details={})
        self.db.vendor_bookings[vendor_id + '|' + ride_id] = VendorBooking(vendor_id=vendor_id, vendor_booking_id=ride_id, platform_booking_id=platform_booking_id, status='scheduled', data={'pickup': pickup, 'dropoff': dropoff, 'pickup_time': pickup_time, 'driver_matched': False, 'est_price': est})
        return {'ride_id': ride_id, 'platform_booking_id': platform_booking_id, 'pickup_time': pickup_time, 'est_price': est}

    @is_tool(ToolType.READ)
    def vendor_check(self, thread_id: str) -> Any:
        """Read a vendor thread with the vendor's reply.

        Args:
            thread_id: str
        """
        thread = self.db.vendor_threads.get(thread_id)
        if thread is None:
            raise ValueError('no such thread')
        return thread.model_dump()

    @is_tool(ToolType.READ)
    def vendor_list_threads(self, platform_booking_id: Optional[str] = None) -> Any:
        """List vendor threads, optionally for one platform booking.

        Args:
            platform_booking_id: str
        """
        if platform_booking_id is None:
            platform_booking_id = ''
        keys = ('thread_id', 'vendor_id', 'platform_booking_id', 'request_type', 'sent_at')
        rows = [{k: t.model_dump()[k] for k in keys} for t in self.db.vendor_threads.values() if not platform_booking_id or t.platform_booking_id == platform_booking_id]
        return {'threads': sorted(rows, key=lambda r: r['thread_id'])}

    @is_tool(ToolType.WRITE)
    def vendor_send(self, vendor_id: str, platform_booking_id: str, request_type: str, message: str, amount: Optional[float] = None, currency: Optional[str] = None) -> Any:
        """Message a vendor desk (hotel, rail, airline, ride). Request types are listed per vendor. The vendor answers
at once by its own rules for the request type, else by the rules every vendor shares (no vendor_id); read the
reply with vendor_check. A rule whose text names a field in braces answers from the vendor's records of the
booking (vendor_booking_id; refund_amount, refund_currency and refund_date of the refund the vendor paid) and
applies only when the booking has that field. A rule marked per_pax limits the amount per passenger (its
amount_lte times the booking's pax).

        Args:
            vendor_id: str
            platform_booking_id: str
            request_type: str
            message: str
            amount: float
            currency: str
        """
        if amount is None:
            amount = 0.0
        if currency is None:
            currency = 'USD'
        v = self.db.vendors.get(vendor_id)
        if v is None:
            raise ValueError(f'unknown vendor_id {vendor_id}')
        accepted = v.request_types or []
        if request_type not in accepted:
            raise ValueError(f'{vendor_id} accepts request types {accepted}')
        pb = self.db.platform_bookings.get(platform_booking_id, PlatformBooking())
        booking_ref = pb.vendor_booking_id
        vb = self.db.vendor_bookings.get(f'{pb.vendor_id}|{pb.vendor_booking_id}', VendorBooking())
        pax = int(next(filter(None, [vb.data]), {}).get('pax', next(filter(None, [pb.details]), {}).get('pax', 1)))
        fields = {'vendor_booking_id': booking_ref} if booking_ref else {}
        paid = sorted(((r.created_at or '', r) for r in self.db.refunds.values() if (r.platform_booking_id, r.source) == (platform_booking_id, 'vendor')), key=lambda pair: pair[0])
        for paid_at, last in paid[-1:]:
            fields.update(refund_amount=f'{float(last.amount):.2f}', refund_currency=last.currency, refund_date=paid_at[:10])
        by_owner = {}
        for r in self.db.vendor_rules.values():
            by_owner.setdefault((r.request_type, r.vendor_id), []).append(r)
        rules = sorted(by_owner.get((request_type, vendor_id)) or by_owner.get((request_type, None), []), key=lambda r: r.rule_id)
        status, text = next(((r.status, r.text.format(**fields)) for r in rules if (r.amount_lte is None or amount <= r.amount_lte * pax ** bool(r.per_pax), {part.split('}')[0] for part in r.text.split('{')[1:]} <= set(fields)) == (True, True)), ('no_reply', ''))
        now = self.db.meta['now'].value
        thread_id = self.ctx.new_id('vendor_threads')
        self.db.vendor_threads[thread_id] = VendorThread(thread_id=thread_id, vendor_id=vendor_id, platform_booking_id=platform_booking_id, request_type=request_type, message=message, amount=amount, currency=currency, sent_at=now, reply_at=now, reply_status=status, reply_text=text)
        return {'thread_id': thread_id, 'sent_at': now}

    @is_tool(ToolType.WRITE)
    def verify_identity(self, customer_id: str, email: str, booking_id: str, card_last4: str) -> Any:
        """IP-1: verify the requester. Needs the customer's email, one of their booking IDs (platform or vendor),
and the last 4 digits of the card that paid for that booking.

        Args:
            customer_id: str
            email: str
            booking_id: str
            card_last4: str
        """
        c = self.db.customers.get(customer_id)
        if c is None:
            raise ValueError('unknown customer')
        booking = None
        for b in self.db.platform_bookings.values():
            if b.customer_id == customer_id and booking_id in (b.platform_booking_id, b.vendor_booking_id):
                booking = b
                break
        ok = booking is not None and (c.email or '').lower() == email.strip().lower()
        if ok:
            pay = self.db.payments.get(booking.payment_id or '')
            ok = pay is not None and pay.card_last4 == card_last4.strip()
        if ok:
            self.db.sessions[customer_id] = Session(customer_id=customer_id, verified_at=self.db.meta['now'].value)
        return {'customer_id': customer_id, 'verified': ok}
