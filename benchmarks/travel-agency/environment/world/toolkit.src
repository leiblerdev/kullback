        rows = [c.model_dump() for c in self.db.contact_history.values() if c.customer_id == customer_id]
        return {'contacts': sorted(rows, key=lambda r: r['ts'] or '')}

    @is_tool(ToolType.READ)
    def get_customer_bookings(self, customer_id: str) -> Any:
        """All platform bookings for a customer, with vendor IDs and vendor booking IDs.

        Args:
            customer_id: str
        """
        rows = [b.model_dump() for b in self.db.platform_bookings.values() if b.customer_id == customer_id]
