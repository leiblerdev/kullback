        rows = [c.model_dump() for c in self.db.commitments.values() if c.customer_id == customer_id]
        return {'commitments': sorted(rows, key=lambda r: r['created_at'] or '')}

    @is_tool(ToolType.READ)
    def get_contact_history(self, customer_id: str) -> Any:
