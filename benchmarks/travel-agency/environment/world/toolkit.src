    @is_tool(ToolType.WRITE)
    def hotel_add_note(self, vendor_id: str, confirmation: str, text: str) -> Any:
        """Add a note the front desk will see (for example a late-arrival time).

        Args:
            vendor_id: str
            confirmation: str
            text: str
        """
        v = self.db.vendors.get(vendor_id)
        if v is None or v.type not in ('hotel', 'hotel_supplier'):
            raise ValueError(f'{vendor_id} is not a hotel')
        vb = self.db.vendor_bookings.get(vendor_id + '|' + confirmation)
        if vb is None:
