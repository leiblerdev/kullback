# Copy to .env (gitignored) and fill in. Nothing in the package sets these; the CLI reads this
# file once, at the point a live adapter is built, and never overrides what is already exported.

# Live model calls are off unless a person turns them on. Without this, every command that takes
# a --model stops with a message instead of spending anything.
HARNESS_ALLOW_MODEL_REQUESTS=1

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# One key for every model OpenCode serves: `--model opencode-go/kimi-k3` or
# `--model opencode/claude-opus-4-7`, with no --base-url. Every other provider models.dev lists
# over the OpenAI shape works the same way, under the key variable that registry names for it.
# OPENCODE_API_KEY=

# Claude on Amazon Bedrock: `--model bedrock/anthropic.claude-opus-5-5` (any Bedrock id after
# `bedrock/`). Set either the Bedrock API key or the access key pair; the API key wins when both
# are set. Comments stay on their own lines: this file is read as KEY=VALUE, with no inline comments.
# A Bedrock API key, sent as a bearer token:
# AWS_BEARER_TOKEN_BEDROCK=
# The access key id that signs each request (SigV4):
# AWS_ACCESS_KEY_ID=
# Its secret, never sent, only used to sign:
# AWS_SECRET_ACCESS_KEY=
# Only for temporary keys (an assumed role or an SSO session):
# AWS_SESSION_TOKEN=
# The Bedrock region; us-east-2 when unset:
# AWS_REGION=us-east-2
