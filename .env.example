# Copy to .env (gitignored) and fill in. Nothing in the package sets these; the CLI reads this
# file once, at the point a live adapter is built, and never overrides what is already exported.

# Live model calls are off unless a person turns them on. Without this, every command that takes
# a --model stops with a message instead of spending anything.
HARNESS_ALLOW_MODEL_REQUESTS=1

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
