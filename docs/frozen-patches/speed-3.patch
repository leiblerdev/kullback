diff --git a/tests/runner/test_ledger_batching.py b/tests/runner/test_ledger_batching.py
new file mode 100644
index 0000000..002da11
--- /dev/null
+++ b/tests/runner/test_ledger_batching.py
@@ -0,0 +1,129 @@
+"""Ledger batching: rows accumulate in memory and the file is written on flush points.
+
+These tests run on the patched tree only (they import flush_ledger and end_stage, which do
+not exist on the unpatched tree). They state the behaviours the patch keeps: rows survive a
+flush, totals match the write through ledger, the ceiling gate sees unflushed spend, a stage
+end flushes, ceilinged calls batch like every other call, a reader process sees a file that
+moved underneath, flushing a workdir that spent nothing writes nothing, two spellings of one
+workdir share one ledger, and the first row of a fresh ledger lands on disk at once.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+
+import pytest
+
+from kullback.runner import budget
+from kullback.runner.records import Cost, Event, Usage
+
+
+def call_event(idx=0, model="anthropic/claude-opus-5", **usage):
+    return Event(
+        idx=idx,
+        type="model_call",
+        cost=Cost(provider=model.split("/")[0], model=model, usage=Usage(**usage), wall_ms=1.0),
+    )
+
+
+def test_rows_survive_a_flush(workdir):
+    for idx in range(5):
+        budget.record_call(call_event(idx=idx, input=100), stage="mine", workdir=workdir)
+    budget.flush_ledger(workdir)
+    totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert totals["stages"]["mine"]["calls"] == 5
+    assert totals["total"]["calls"] == 5
+
+
+def test_totals_match_after_flush(workdir):
+    for idx in range(10):
+        budget.record_call(call_event(idx=idx, input=100 + idx, output=idx), stage="mine",
+                           workdir=workdir)
+        budget.record_call(call_event(idx=100 + idx, input=50), stage="reroll", workdir=workdir)
+    budget.flush_ledger(workdir)
+    file_totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    mem_totals = budget.load_totals(workdir)
+    assert file_totals == mem_totals
+    assert file_totals["total"]["calls"] == 20
+    assert file_totals["total"]["usd"] == pytest.approx(mem_totals["total"]["usd"])
+
+
+def test_the_ceiling_gate_sees_unflushed_spend(workdir):
+    ceiling = budget.Ceiling(usd=100.0, workdir=workdir)
+    budget.record_call(call_event(input=1_000_000), stage="mine", workdir=workdir,
+                       ceiling=None)
+    # No flush yet, but the gate reads the in memory totals, not the file.
+    assert budget.load_totals(workdir)["total"]["usd"] > 0
+    assert ceiling.spent == 0.0
+    budget.record_call(call_event(idx=1, input=1_000_000), stage="mine", workdir=workdir,
+                       ceiling=ceiling)
+    assert ceiling.spent > 0
+    assert budget.load_totals(workdir)["total"]["usd"] == pytest.approx(ceiling.spent)
+
+
+def test_a_stage_end_flushes(workdir):
+    budget.record_call(call_event(input=100), stage="mine", workdir=workdir)
+    budget.end_stage(workdir, "mine")
+    totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert totals["stages"]["mine"]["calls"] == 1
+
+
+def test_ceilinged_calls_batch_between_flushes(workdir):
+    ceiling = budget.Ceiling(usd=10_000.0, workdir=workdir)
+    for idx in range(10):
+        budget.record_call(call_event(idx=idx, input=100), stage="mine", workdir=workdir,
+                           ceiling=ceiling)
+    assert ceiling.spent > 0
+    assert budget.load_totals(workdir)["total"]["calls"] == 10
+    # Only the first row forced a write; the other nine are still in memory.
+    file_totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert file_totals["total"]["calls"] == 1
+    budget.flush_ledger(workdir)
+    file_totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert file_totals["total"]["calls"] == 10
+
+
+def test_a_reader_sees_a_file_that_moved_underneath(tmp_path):
+    other = tmp_path / "elsewhere"
+    other.mkdir()
+    first = budget.empty_totals()
+    first["stages"]["mine"] = {**budget.empty_bucket(), "calls": 1, "usd": 1.0}
+    first["total"] = {**budget.empty_bucket(), "calls": 1, "usd": 1.0}
+    (other / budget.TOTALS_NAME).write_text(json.dumps(first), encoding="utf-8")
+    assert budget.load_totals(other)["total"]["usd"] == pytest.approx(1.0)
+    second = budget.empty_totals()
+    second["stages"]["another-stage-with-a-longer-name"] = {
+        **budget.empty_bucket(), "calls": 2, "usd": 2.0}
+    second["total"] = {**budget.empty_bucket(), "calls": 2, "usd": 2.0}
+    (other / budget.TOTALS_NAME).write_text(json.dumps(second), encoding="utf-8")
+    assert budget.load_totals(other)["total"]["usd"] == pytest.approx(2.0)
+
+
+def test_flushing_a_workdir_that_spent_nothing_writes_nothing(workdir, tmp_path):
+    fresh = tmp_path / "fresh"
+    fresh.mkdir()
+    budget.flush_ledger(fresh)
+    budget.end_stage(fresh, "mine")
+    assert not (fresh / budget.TOTALS_NAME).exists()
+
+
+def test_two_spellings_of_one_workdir_share_one_ledger(workdir, monkeypatch):
+    monkeypatch.chdir(workdir.parent)
+    relative = os.path.basename(str(workdir))
+    absolute = str(workdir)
+    for idx in range(3):
+        budget.record_call(call_event(idx=idx, input=100), stage="mine", workdir=relative)
+    for idx in range(3, 6):
+        budget.record_call(call_event(idx=idx, input=100), stage="mine", workdir=absolute)
+    budget.flush_ledger(absolute)
+    totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert totals["total"]["calls"] == 6
+
+
+def test_the_first_row_of_a_fresh_ledger_lands_on_disk(workdir, tmp_path):
+    fresh = tmp_path / "fresh"
+    fresh.mkdir()
+    budget.record_call(call_event(input=100), stage="mine", workdir=fresh)
+    totals = json.loads((fresh / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert totals["stages"]["mine"]["calls"] == 1
