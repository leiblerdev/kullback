diff --git a/tests/runner/test_ledger_batching.py b/tests/runner/test_ledger_batching.py
new file mode 100644
index 0000000..ca5fecd
--- /dev/null
+++ b/tests/runner/test_ledger_batching.py
@@ -0,0 +1,66 @@
+"""Ledger batching: rows accumulate in memory and the file is written on flush points.
+
+These tests run on the patched tree only (they import flush_ledger and end_stage, which do
+not exist on the unpatched tree). They state the four behaviours the patch keeps: rows
+survive a flush, totals match the write through ledger, the ceiling gate sees unflushed
+spend, and a stage end flushes.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from kullback.runner import budget
+from kullback.runner.records import Cost, Event, Usage
+
+
+def call_event(idx=0, model="anthropic/claude-opus-5", **usage):
+    return Event(
+        idx=idx,
+        type="model_call",
+        cost=Cost(provider=model.split("/")[0], model=model, usage=Usage(**usage), wall_ms=1.0),
+    )
+
+
+def test_rows_survive_a_flush(workdir):
+    for idx in range(5):
+        budget.record_call(call_event(idx=idx, input=100), stage="mine", workdir=workdir)
+    budget.flush_ledger(workdir)
+    totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert totals["stages"]["mine"]["calls"] == 5
+    assert totals["total"]["calls"] == 5
+
+
+def test_totals_match_after_flush(workdir):
+    for idx in range(10):
+        budget.record_call(call_event(idx=idx, input=100 + idx, output=idx), stage="mine",
+                           workdir=workdir)
+        budget.record_call(call_event(idx=100 + idx, input=50), stage="reroll", workdir=workdir)
+    budget.flush_ledger(workdir)
+    file_totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    mem_totals = budget.load_totals(workdir)
+    assert file_totals == mem_totals
+    assert file_totals["total"]["calls"] == 20
+    assert file_totals["total"]["usd"] == pytest.approx(mem_totals["total"]["usd"])
+
+
+def test_the_ceiling_gate_sees_unflushed_spend(workdir):
+    ceiling = budget.Ceiling(usd=100.0, workdir=workdir)
+    budget.record_call(call_event(input=1_000_000), stage="mine", workdir=workdir,
+                       ceiling=None)
+    # No flush yet, but the gate reads the in memory totals, not the file.
+    assert budget.load_totals(workdir)["total"]["usd"] > 0
+    assert ceiling.spent == 0.0
+    budget.record_call(call_event(idx=1, input=1_000_000), stage="mine", workdir=workdir,
+                       ceiling=ceiling)
+    assert ceiling.spent > 0
+    assert budget.load_totals(workdir)["total"]["usd"] == pytest.approx(ceiling.spent)
+
+
+def test_a_stage_end_flushes(workdir):
+    budget.record_call(call_event(input=100), stage="mine", workdir=workdir)
+    budget.end_stage(workdir, "mine")
+    totals = json.loads((workdir / budget.TOTALS_NAME).read_text(encoding="utf-8"))
+    assert totals["stages"]["mine"]["calls"] == 1
